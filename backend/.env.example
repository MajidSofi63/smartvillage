# Copy this file to .env (in the same backend/ folder) and fill in your real values.
# .env is in .gitignore, so your real keys never get committed to GitHub.

DATABASE_URL=postgresql://username:password@host.neon.tech/dbname?sslmode=require
WEATHER_API_KEY=your_openweather_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase (Settings -> API in your Supabase project) - used only for login/register
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Admin panel password - pick something real, not "changeme"
ADMIN_PASSWORD=changeme
