# Copy this file to .env and fill in the real values.
# .env is git-ignored and must never be committed.

# PostgreSQL connection string used by the platform tables AND the crop
# recommendation tables (districts / crop_stats).
# Example (Neon): postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Google Gemini - used by the chat assistant, telemedicine rewriting, and the
# top crop's reason rewriting. Leave the placeholder to disable Gemini.
GEMINI_API_KEY=PUT_YOUR_GEMINI_API_KEY_HERE

# Optional: model name, and a master on/off switch for all Gemini calls.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_ENABLED=true

# OpenWeather - used by the disaster alerts tab.
WEATHER_API_KEY=PUT_YOUR_OPENWEATHER_API_KEY_HERE

# Supabase - worker accounts and authentication.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin panel password (/admin).
ADMIN_PASSWORD=changeme
